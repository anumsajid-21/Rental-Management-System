# Server runtime port
PORT=5000

# Secret used to sign JWTs. CHANGE THIS in your local copy.
# Every teammate can use their own value; it must never be committed.
JWT_SECRET=change-me-in-local-env

# Token lifetime
JWT_EXPIRES_IN=7d

# SQLite database file location (relative to the server folder)
DB_FILE=data/rental.db

# Allowed client origin (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API Key for AI features (optional — smart fallback used if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Stripe Payment Gateway API (optional — simulation mode used if omitted)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_key

# Transactional Email / SMTP (optional — simulated logger used if omitted)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Rehainsh Rentals <no-reply@rehainsh.pk>"

# Upload directory
UPLOAD_DIR=uploads
